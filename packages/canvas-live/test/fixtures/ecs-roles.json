      }
    },
    {
      "id": "f-admin",
      "type": "note",
      "x": 785.0,
      "y": -320.0,
      "data": {
        "title": "Administration",
        "body": "Platform config. ECS_ADMIN only.",
        "tone": "danger"
      }
    },
    {
      "id": "s1",
      "type": "note",
      "x": 335.0,
      "y": 1052.0,
      "data": {
        "title": "1 · Sign in",
        "body": "Auth0 token proves who you are; it only carries a coarse admin/user flag.",
        "tone": "muted"
      }
    },
    {
      "id": "s2",
      "type": "note",
      "x": 847.0,
      "y": 1171.0,
      "data": {
        "title": "2 · Load the real role",
        "body": "API looks up your user + merchant associations + role in PlatformDB (cached 1h).",
        "tone": "muted"
      }
    },
    {
      "id": "s3",
      "type": "note",
      "x": 1303.0,
      "y": 1174.0,
      "data": {
        "title": "3 · Pick the merchant",
        "body": "Session merchant header must be one of yours. ECS_ADMIN/SUPPORT may pick any.",
        "tone": "muted"
      }
    },
    {
      "id": "s4",
      "type": "note",
      "x": 1803.0,
      "y": 1192.0,
      "data": {
        "title": "4 · Capability (OPA)",
        "body": "role_permissions + additive overrides: can this role list/read/create/update/delete/export the type? Also drives nav visibility.",
        "tone": "muted"
      }
    },
    {
      "id": "s5",
      "type": "note",
      "x": 2284.0,
      "y": 1171.0,
      "data": {
        "title": "5 · Scope (OPA)",
        "body": "grants: which locations at this merchant (all or listed). Needed for instance-level checks.",
        "tone": "muted"
      }
    },
    {
      "id": "s6",
      "type": "note",
      "x": 2808.0,
      "y": 1150.0,
      "data": {
        "title": "Answer",
        "body": "Allowed = membership + capability (+ scope for one record). OPA down = 503, never allow.",
        "tone": "accent"
      }
    },
    {
      "id": "caveat",
      "type": "note",
      "x": 335.0,
      "y": 1215.0,
      "data": {
        "title": "Docs vs code",
        "body": "IT_USER is 'Future' in definitions but active in the matrix; nav table and matrix disagree on My Orders, Print Jobs, Locations. M = depends on your role at that merchant.",
        "tone": "warn"
      }
    },
    {
