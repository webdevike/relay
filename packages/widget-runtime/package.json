{
  "name": "@relay/widget-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-made widgets for Relay phone and desktop and canvas prototypes: the shared Mantine theme, the design systems (Relay, eCard), the sandboxed frame documents, and the offline Mantine runtime bundle.",
  "exports": {
    "./theme": "./src/theme.ts",
    "./theme-components.css": "./src/theme-components.css",
    "./frame": "./src/frame.ts",
    "./proto": "./src/proto.ts",
    "./systems": "./src/systems/index.ts"
  },
  "scripts": {
    "build": "bun build.ts",
    "lint": "oxlint --type-aware src test build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tsc6": "tsc6 --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@mantine/charts": "9.7.2",
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^26",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sucrase": "3.35.1",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vitest": "^3.2.0"
  }
}
