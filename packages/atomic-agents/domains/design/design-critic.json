{
  "id": "design-critic",
  "purpose": "Score one rendered UI against Isaac's design rules and list the fixes, ranked.",
  "agent": {
    "model": "anthropic/claude-sonnet-5-5",
    "candidates": [
      "anthropic/claude-sonnet-5-5",
      "anthropic/claude-opus-5-5",
      "openai-codex/gpt-6.1-sol",
      "anthropic/claude-haiku-5-5",
      "openai-codex/gpt-6-astra",
      "openai-codex/gpt-6-luna"
    ],
    "thinking": "low",
    "trial": true,
    "system": [
      "You are Isaac's design critic. You get screenshots of one rendered screen and what the screen is for, and you judge it against his design rules below. You never build, edit or redesign; you score and list fixes.",
      "",
      "- Judge only what the screenshots show. Do not guess hover, open or loading states you cannot see.",
      "- Score 0 to 10 (one decimal allowed) on the scale in the rules. Judge the design, not the data in it.",
      "- Findings: the real problems, most important first, at most 8. Each cites exactly one rule id, names the element so Isaac can find it (its visible text and where it sits), and gives a concrete fix (what to change to what). One finding per problem; no praise, no restating rules in general.",
      "- Severity: blocking, major or minor, as the rules define them.",
      "- summary: one or two sentences, the verdict and the one fix that matters most.",
      "- Plain words, no em dashes."
    ],
    "knowledge": [
      {
        "file": "design-critic.rules.md"
      }
    ]
  },
  "events": {
    "ui.rendered": {
      "requestId?": "nonEmptyString",
      "url?": "nonEmptyString",
      "screenshot?": "nonEmptyString",
      "viewports?": {
        "array": "int"
      },
      "intent": "nonEmptyString"
    },
    "design.critique": {
      "requestId?": "nonEmptyString",
      "url?": "string",
      "screenshot?": "string",
      "intent": "string",
      "screenshots": {
        "array": "string"
      },
      "viewports": {
        "array": "int"
      },
      "score": "number",
      "findings": {
        "array": {
          "rule": "string",
          "element": "string",
          "fix": "string",
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor"
            ]
          },
          "measured?": "boolean"
        }
      },
      "summary": "string",
      "evidence?": {
        "array": {
          "rule": "string",
          "severity": {
            "enum": [
              "error",
              "warn"
            ]
          },
          "selector": "string",
          "label?": "string",
          "viewport": {
            "array": "number"
          },
          "fix": "string"
        }
      },
      "model": "string",
      "attempts": "int",
      "cost": "number",
      "seconds": "number"
    }
  },
  "job": {
    "id": "critique",
    "description": "Shoot the page (or take the screenshot), have the model score it against Isaac's rules with ranked fixes, attach ui-check measurements as evidence, emit design.critique.",
    "input": "ui.rendered",
    "triggers": [
      {
        "onEvent": "ui.rendered"
      },
      "manual"
    ],
    "source": "browser.screenshot",
    "attach": [
      "screenshots"
    ],
    "prompt": [
      "What this screen is for: {{intent}}",
      "What you are looking at: {{page}}",
      "",
      "Critique it."
    ],
    "timeout": 180,
    "answer": {
      "score": "number",
      "findings": {
        "array": {
          "rule": {
            "enum": [
              "hierarchy",
              "spacing-grouping",
              "remove-it",
              "caps-eyebrow",
              "border-or-shadow",
              "vibe-coded",
              "quiet-hover",
              "icons",
              "em-dash",
              "copy",
              "table-alignment",
              "action-hierarchy",
              "consistency",
              "typography",
              "contrast",
              "data-drives-form",
              "labels",
              "fewer-borders",
              "whitespace",
              "disclosure",
              "app-shell",
              "overlap",
              "clipped-text",
              "page-overflow",
              "touch-target",
              "alignment",
              "tiny-text"
            ]
          },
          "element": "nonEmptyString",
          "fix": "nonEmptyString",
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor"
            ]
          }
        }
      },
      "summary": "nonEmptyString"
    },
    "answerExample": "{\"score\": 6.5, \"findings\": [{\"rule\": \"<rule id>\", \"element\": \"<visible text and where it sits>\", \"fix\": \"<what to change to what>\", \"severity\": \"blocking\" | \"major\" | \"minor\"}], \"summary\": \"<verdict and the fix that matters most>\"}",
    "maxSteps": 2,
    "check": "ui-check.evidence",
    "output": "design.critique"
  },
  "asks": {
    "request": "ui.rendered",
    "reply": "design.critique",
    "show": "summary"
  }
}
