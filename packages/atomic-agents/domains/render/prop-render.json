{
  "id": "prop-render",
  "purpose": "Turn a one-line object description into a studio render of a 3D model built in Blender.",
  "agent": {
    "model": "openrouter/moonshotai/kimi-k3.1-pro",
    "candidates": [
      "openrouter/moonshotai/kimi-k3.1-pro",
      "openai-codex/gpt-6-sol",
      "openrouter/google/gemini-4-carbon",
      "openai-codex/gpt-6-astra",
      "anthropic/claude-opus-5-5"
    ],
    "thinking": "low",
    "system": "You are a 3D prop modeller. You write one Blender Python script that builds a single object from primitives, modifiers and materials.",
    "knowledge": [
      {
        "file": "prop-render.knowledge.md"
      }
    ]
  },
  "events": {
    "render.requested": {
      "subject": "nonEmptyString"
    },
    "render.completed": {
      "subject": "string",
      "model": "string",
      "image": "string",
      "glb": "string",
      "script": "string",
      "attempts": "int",
      "seconds": "number",
      "cost": "number"
    }
  },
  "job": {
    "id": "render",
    "description": "Model one object as a Blender script, render it on the stage, emit render.completed.",
    "input": {
      "subject": "nonEmptyString"
    },
    "triggers": [
      "manual",
      {
        "onEvent": "render.requested"
      },
      {
        "cron": "0 9 * * *",
        "inputs": [
          {
            "subject": "a brass desk lamp with an articulated arm"
          },
          {
            "subject": "a ceramic coffee mug with a chipped rim"
          },
          {
            "subject": "a vintage rotary telephone"
          },
          {
            "subject": "a potted succulent in a terracotta pot"
          },
          {
            "subject": "a wooden chess rook"
          },
          {
            "subject": "a retro robot toy"
          },
          {
            "subject": "a glass perfume bottle with a gold cap"
          }
        ]
      }
    ],
    "prompt": "Model this object: {{subject}}",
    "check": "blender.render",
    "output": "render.completed"
  }
}
