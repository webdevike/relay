    "@xyflow/react": "12.12.0",
    "jsdom": "^26",
    "lib0": "0.2.119",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33"
  }
