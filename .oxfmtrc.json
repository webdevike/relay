{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": false,
  "overrides": [
    {
      "files": [
        "apps/desktop/**",
        "packages/browser-core/**",
        "packages/chat-core/**",
        "packages/contract/**",
        "packages/eva-core/**",
        "packages/shell-core/**",
        "scripts/**",
        "stylelint.config.mjs"
      ],
      "options": {
        "semi": false,
        "singleQuote": true
      }
    }
  ],
  "ignorePatterns": [
    ".planning",
    "fixtures",
    "proof",
    "out",
    "release",
    "pnpm-lock.yaml",
    ".claude",
    ".tools",
    "logs",
    "test-results",
    "IDEA.md",
    "CLAUDE.md",
    "*.sh",
    "packages/eva-core/src/model/__fixtures__",
    "packages/chat-core/src/openui/lang",
    "apps/desktop/resources/setup"
  ]
}
