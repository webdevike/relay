{
  "name": "relay",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:tsc6": "turbo run typecheck:tsc6",
    "test": "turbo run test",
    "build": "turbo run build",
    "check": "turbo run lint typecheck test build",
    "affected": "turbo run lint typecheck test build --filter=...[HEAD^1]",
    "format": "oxfmt \"**/*.{ts,tsx,json,md,yaml}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,json,md,yaml}\"",
    "ota:publish": "pnpm --filter @relay/ota-server ota:publish",
    "ota:install": "pnpm --filter @relay/ota-server ota:install",
    "dev": "pnpm -C apps/desktop dev",
    "dev:live": "pnpm -C apps/desktop dev:live",
    "e2e": "pnpm -C apps/desktop e2e",
    "gate": "bash scripts/gate.sh"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "stylelint": "^17.16.0",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vitest": "^3.2.0"
  }
}
