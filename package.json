{
  "name": "evaos-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm -C apps/desktop dev",
    "dev:live": "pnpm -C apps/desktop dev:live",
    "build": "pnpm -C apps/desktop build",
    "test-bench": "pnpm --silent -C apps/desktop test-bench",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check . && node scripts/lint-em-dash.ts",
    "test": "vitest run",
    "e2e": "pnpm -C apps/desktop e2e",
    "gate": "bash scripts/gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "get-shit-done-cc": "^1.42.3",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "5.0.4"
  }
}
