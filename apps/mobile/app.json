{
  "expo": {
    "name": "Relay",
    "slug": "relay",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://isaacs-mac-mini.tail80fdb0.ts.net:8447/api/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "relay",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0C",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ike.relay",
      "buildNumber": "13",
      "appleTeamId": "CH63V3XD76",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSLocalNetworkUsageDescription": "Relay finds your Mac on the local network.",
        "NSBonjourServices": [
          "_relay._tcp"
        ],
        "NSMicrophoneUsageDescription": "Relay listens while you dictate or talk to your assistants on a call.",
        "NSSpeechRecognitionUsageDescription": "Relay turns your dictation into text for your Mac.",
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "omarchy.tail80fdb0.ts.net": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Relay confirms it is you before approving a destructive action from your phone."
        }
      ],
      "./plugins/withSceneLifecycle",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Relay listens while you dictate.",
          "speechRecognitionPermission": "Relay turns your dictation into text for your Mac."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Relay saves shared images to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Relay takes a photo as proof when you finish a habit.",
          "photosPermission": "Relay picks a photo as proof when you finish a habit.",
          "microphonePermission": false
        }
      ],
      "./plugins/withPodDeploymentFloor",
      "./plugins/withLiveCallIntents",
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0",
            "useFrameworks": "dynamic",
            "forceStaticLinking": ["react-native-zeroconf"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "618b10e6-3bdd-49af-b386-fff91c5a267f"
      }
    },
    "owner": "ikey2244"
  }
}
