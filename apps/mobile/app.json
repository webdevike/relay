{
  "expo": {
    "name": "Relay",
    "slug": "relay",
    "version": "0.1.0",
    "scheme": "relay",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ike.relay",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Relay finds your Mac on the local network.",
        "NSBonjourServices": [
          "_relay._tcp"
        ],
        "NSMicrophoneUsageDescription": "Relay listens while you dictate.",
        "NSSpeechRecognitionUsageDescription": "Relay turns your dictation into text for your Mac.",
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Relay listens while you dictate.",
          "speechRecognitionPermission": "Relay turns your dictation into text for your Mac."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "618b10e6-3bdd-49af-b386-fff91c5a267f"
      }
    },
    "owner": "ikey2244"
  }
}
