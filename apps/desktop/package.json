{
  "name": "@evaos/desktop",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:live": "node -e \"console.warn('RELAY DEV (live data): real Eva root and real omp, config ~/Library/Application Support/Relay Dev, CDP 9340. The stable app is never touched.')\" && EVAOS_LIVE=1 EVAOS_EVA_ROOT=$HOME/Eva EVAOS_OMP_BIN=omp electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:setup": "node --test scripts/setup-json.test.mjs",
    "lint": "cd ../.. && node_modules/.bin/eslint eslint.config.mjs stylelint.config.mjs scripts apps/desktop packages/browser-core packages/chat-core packages/contract packages/eva-core packages/shell-core && node_modules/.bin/prettier --check .prettierrc eslint.config.mjs stylelint.config.mjs scripts apps/desktop packages/browser-core packages/chat-core packages/contract packages/eva-core packages/shell-core && node scripts/lint-em-dash.ts && node scripts/lint-spacing.ts",
    "e2e": "electron-vite build && node scripts/e2e.mjs",
    "e2e:run": "node scripts/e2e.mjs",
    "e2e:smoke": "electron-vite build && node scripts/e2e.mjs --grep @smoke",
    "package": "electron-vite build && electron-builder --dir --publish never",
    "package:onboarding": "bash scripts/package-onboarding.sh"
  },
  "dependencies": {
    "@dicebear/micah": "^9.4.3",
    "@mantine/code-highlight": "9.7.2",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@dicebear/core": "^9.4.3",
    "@dicebear/notionists": "^9.4.2",
    "@dnd-kit/core": "6.3.1",
    "@evaos/browser-core": "workspace:*",
    "@evaos/chat-core": "workspace:*",
    "@evaos/contract": "workspace:*",
    "@evaos/eva-core": "workspace:*",
    "@evaos/shell-core": "workspace:*",
    "@mantine/charts": "9.7.2",
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@mantine/tiptap": "9.7.2",
    "@playwright/test": "1.64.1",
    "@relay/canvas-live": "link:../../packages/canvas-live",
    "@relay/portrait-motion": "link:../../packages/portrait-motion",
    "@relay/protocol": "link:../../packages/protocol",
    "@relay/slack-emoji": "link:../../packages/slack-emoji",
    "@relay/widget-runtime": "link:../../packages/widget-runtime",
    "@tabler/icons-react": "3.49.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-code": "3.32.2",
    "@tiptap/extension-collaboration": "3.32.2",
    "@tiptap/extension-collaboration-caret": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/y-tiptap": "3.0.12",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "chokidar": "5.0.0",
    "dockview-react": "8.8.3",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.2",
    "material-icon-theme": "5.39.0",
    "monaco-editor": "0.57.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "virtua": "0.53.5",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  }
}
