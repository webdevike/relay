{
  "name": "@evaos/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:live": "node -e \"console.warn('EVAOS LIVE MODE: real Eva root and real omp')\" && EVAOS_LIVE=1 EVAOS_EVA_ROOT=$HOME/Eva EVAOS_OMP_BIN=omp electron-vite dev",
    "build": "electron-vite build",
    "test-bench": "node scripts/test-bench.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "e2e": "electron-vite build && playwright test",
    "e2e:run": "playwright test",
    "package": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@mantine/code-highlight": "9.7.2",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@dnd-kit/core": "6.3.1",
    "@evaos/browser-core": "workspace:*",
    "@evaos/chat-core": "workspace:*",
    "@evaos/contract": "workspace:*",
    "@evaos/eva-core": "workspace:*",
    "@evaos/shell-core": "workspace:*",
    "@mantine/charts": "9.7.2",
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@playwright/test": "1.64.1",
    "@tabler/icons-react": "3.49.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "^12.12.0",
    "chokidar": "5.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.2",
    "pngjs": "7.0.0",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "virtua": "0.53.5",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  }
